<%- include('layout', { body: `
<h2><i class='fas fa-globe'></i> Tor Website (.onion Hidden Service)</h2>

<div class='grid grid-2'>
  <div class='card'>
    <h3>Service Status</h3>
    <div class='card-content'>
      <div class='status-row'>
        <span>Tor Service:</span>
        <span id='tor-running' class='badge badge-unknown'>Checking...</span>
      </div>
      <div class='status-row'>
        <span>.onion Address:</span>
        <code id='onion-address' class='onion-addr'>Loading...</code>
        <button class='btn btn-sm' onclick='copyOnion()' title='Copy'><i class='fas fa-copy'></i></button>
      </div>
      <div class='btn-group' style='margin-top: 1rem;'>
        <button class='btn btn-success' onclick='torAction(\"start\")'><i class='fas fa-play'></i> Start</button>
        <button class='btn btn-danger' onclick='torAction(\"stop\")'><i class='fas fa-stop'></i> Stop</button>
        <button class='btn btn-warning' onclick='torAction(\"restart\")'><i class='fas fa-sync'></i> Restart</button>
        <button class='btn btn-primary' onclick='torAction(\"configure\")'><i class='fas fa-cog'></i> Configure torrc</button>
      </div>
      <div id='tor-message' class='message' style='margin-top: 0.5rem;'></div>
    </div>
  </div>

  <div class='card'>
    <h3>Website Files</h3>
    <div class='card-content'>
      <div id='website-files' class='file-list'>Loading...</div>
    </div>
  </div>
</div>

<div class='card'>
  <h3><i class='fas fa-edit'></i> Edit Website File</h3>
  <div class='card-content'>
    <div class='form-group'>
      <label>File: <span id='editing-file'>Select a file above</span></label>
      <textarea id='file-editor' class='code-editor' rows='20' placeholder='Select a file to edit...'></textarea>
    </div>
    <button class='btn btn-primary' onclick='saveFile()'><i class='fas fa-save'></i> Save</button>
    <span id='save-message' class='message'></span>
  </div>
</div>

<script src='/js/tor.js'></script>
` }) %>

<%- include('layout', { body: `
<h2><i class='fas fa-plug'></i> GPIO Control</h2>

<div class='card'>
  <h3>GPIO Status</h3>
  <div class='card-content'>
    <p>Available: <span id='gpio-available' class='badge badge-unknown'>Checking...</span></p>
    <p style='margin-top:0.4rem;'>Preset: <span id='gpio-preset-name' class='badge'>--</span>
      <span id='gpio-preset-model' style='font-size:0.82rem;color:var(--text-secondary);margin-left:0.5rem;'></span></p>
    <div class='btn-group' style='margin-top:0.5rem;'>
      <button class='btn btn-sm btn-primary' onclick='applyPresetDefaults()'><i class='fas fa-magic'></i> Apply Preset Defaults</button>
    </div>
    <div id='gpio-preset-msg' class='message'></div>
  </div>
</div>

<div class='card'>
  <h3><i class='fas fa-th'></i> Raspberry Pi 40-Pin Header</h3>
  <div class='card-content'>
    <div class='gpio-board' id='gpio-board'>
      <!-- Generated by JavaScript -->
      <p>Loading pin layout...</p>
    </div>
  </div>
</div>

<div class='grid grid-2'>
  <div class='card'>
    <h3><i class='fas fa-sliders-h'></i> Configure Pin</h3>
    <div class='card-content'>
      <div class='form-group'>
        <label for='gpio-select'>GPIO Number</label>
        <select id='gpio-select' class='form-control'><option value=''>Select GPIO...</option></select>
      </div>
      <div class='form-group'>
        <label for='gpio-dir'>Direction</label>
        <select id='gpio-dir' class='form-control'>
          <option value='out'>Output</option>
          <option value='in'>Input</option>
        </select>
      </div>
      <button class='btn btn-primary' onclick='configurePin()'><i class='fas fa-check'></i> Configure</button>
      <div id='gpio-config-msg' class='message'></div>
    </div>
  </div>

  <div class='card'>
    <h3><i class='fas fa-list'></i> Active Pins</h3>
    <div class='card-content'>
      <table class='table' id='gpio-active'>
        <thead><tr><th>GPIO</th><th>Dir</th><th>Value</th><th>Action</th></tr></thead>
        <tbody><tr><td colspan='4'>No pins configured</td></tr></tbody>
      </table>
    </div>
  </div>
</div>

<script src='/js/gpio.js'></script>
` }) %>

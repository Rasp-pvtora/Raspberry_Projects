# ============================================================
# Tor Security Node — Environment Configuration
# ============================================================
# Copy this file to .env and edit the values.
#   cp .env.default .env
#
# NEVER commit the .env file to version control.
# ============================================================

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Session ---
# Generate a random secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# --- Authentication ---
# These are the initial login credentials for the web dashboard.
# You can change them later from the Settings page in the UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Tor Hidden Service ---
# Directory where Tor stores hidden service keys (auto-created by Tor)
TOR_HIDDEN_SERVICE_DIR=/var/lib/tor/tor-security-node
# Local directory containing the website files to serve via .onion
TOR_WEBSITE_DIR=./website
# Tor control port (for managing Tor programmatically)
TOR_CONTROL_PORT=9051
# Tor SOCKS port
TOR_SOCKS_PORT=9050

# --- Tor Access Point ---
# WiFi interface used by the Pi to create the hotspot
AP_INTERFACE=wlan0
# Access point SSID (WiFi name)
AP_SSID=TorSecurityNode
# Access point WPA2 passphrase (min 8 characters)
AP_PASSPHRASE=changeme123
# Subnet for the access point (clients get IPs in this range)
AP_SUBNET=10.3.141
# Upstream interface for internet (Ethernet or second WiFi adapter)
AP_UPSTREAM_INTERFACE=eth0
# Tor TransPort for transparent proxying
TOR_TRANSPORT_PORT=9040
# Tor DNS port
TOR_DNS_PORT=5353

# --- GPIO ---
# Enable or disable GPIO features (set to false on non-Pi hardware)
GPIO_ENABLED=true

# --- File Browser ---
# Root directory for the file browser (restrict browsing to this path)
FILE_BROWSER_ROOT=/home/pi
